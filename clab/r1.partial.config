/configure system management-interface cli md-cli environment command-alias alias "commit-script" admin-state enable
/configure system management-interface cli md-cli environment command-alias alias "commit-script" description "Commit script example"
/configure system management-interface cli md-cli environment command-alias alias "commit-script" cli-command "exec \"tftp://172.31.255.29/commit-script\""
/configure system { management-interface cli md-cli environment command-alias alias "commit-script" mount-point global }
/configure system security aaa remote-servers tacplus admin-state enable
/configure system security aaa remote-servers tacplus use-default-template true
/configure system security aaa remote-servers tacplus authorization use-priv-lvl true
/configure system security aaa remote-servers tacplus priv-lvl-map priv-lvl 1 user-profile-name "noc"
/configure system security aaa remote-servers tacplus priv-lvl-map priv-lvl 15 user-profile-name "administrative"
/configure system security aaa remote-servers tacplus server 1 address 192.168.49.49
/configure system security aaa remote-servers tacplus server 1 port 49
/configure system security aaa remote-servers tacplus server 1 secret "RgRiYUVj60EYD8H/9/nwI5REgcWNZ/sZJLc= hash2"
/configure system security aaa local-profiles profile "noc" default-action permit-all
/configure system security aaa local-profiles profile "noc" entry 10 match "commit"
/configure system security aaa local-profiles profile "noc" entry 10 action deny
/configure system security user-params local-user user "noc" password "$2y$10$Ak50NfpLVpju.z3ntqt1w.hF8gIs3vQpQUr2CJ77GfYNopdjGhJqG"
/configure system security user-params local-user user "noc" access console true
/configure system security user-params local-user user "noc" console member ["noc"]
